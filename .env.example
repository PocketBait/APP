# Copia este archivo como ".env" (mismo folder) y llena los valores reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore) — cada quien lo
# configura localmente con sus propias claves.
#
# De dónde sacar estos valores: docs/SETUP.md, sección "Supabase".

SUPABASE_URL=https://TU-PROYECTO.supabase.co
# En Supabase Dashboard -> Project Settings -> API: "Publishable key"
# (en proyectos más viejos puede aparecer como "anon" / "public" key).
SUPABASE_PUBLISHABLE_KEY=TU-PUBLISHABLE-KEY

# Client ID de tipo "Web application" de Google Cloud Console.
# Se usa en Android/iOS para el flujo de Google Sign-In vía Supabase.
GOOGLE_WEB_CLIENT_ID=TU-CLIENT-ID.apps.googleusercontent.com

# Client ID de tipo "iOS" de Google Cloud Console (solo iOS).
GOOGLE_IOS_CLIENT_ID=TU-CLIENT-ID.apps.googleusercontent.com
